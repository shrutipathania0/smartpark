# SmartPark AI Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=smartpark-ai-super-secret-key-change-in-production-2026
PORT=8000
HOST=127.0.0.1

# Database Configuration
DATABASE_URL=sqlite:///data/smartpark.db

# Storage
CAPTURES_DIR=data/captures
LOGS_DIR=data/logs

# Machine Learning & ANPR
DETECTOR_MODEL_PATH=models/detector/best.pt
OCR_CONFIDENCE_THRESHOLD=0.55
HIGH_CONFIDENCE_THRESHOLD=0.80

# Default Parking Slot Distribution
DISABLED_SLOTS=3
EV_SLOTS=3
NORMAL_SLOTS=9

